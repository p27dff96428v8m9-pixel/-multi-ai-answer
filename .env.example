GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_FREE_MODEL=openrouter/auto
OPENROUTER_QWEN_MODEL=qwen/qwen3-14b:free

# Optional paid / BYOK providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Simple mode relay.
# Leave empty during local development to use this Next.js app's /api/ask route.
# For a standalone Android build, set this to your deployed relay origin.
NEXT_PUBLIC_SIMPLE_RELAY_URL=

# Free-tier protection
DAILY_SIMPLE_REQUEST_LIMIT=10
DAILY_ADVANCED_REQUEST_LIMIT=30
MAX_QUESTION_LENGTH=1200
SIMPLE_PROVIDER_LIMIT=1
