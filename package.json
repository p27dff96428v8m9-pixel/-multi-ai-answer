{
  "name": "multi-ai-answer",
  "version": "0.1.0",
  "private": true,
  "description": "複数AIの回答を統合して1つの結論を返すNext.js MVP",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "set CAPACITOR_STATIC=1&& next build",
    "start": "next start",
    "lint": "next lint",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:sync:static": "set CAPACITOR_STATIC=1&& cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@tailwindcss/postcss": "^4.1.8",
    "isexe": "^2.0.0",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
